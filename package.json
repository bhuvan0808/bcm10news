{
  "name": "bcm10-news",
  "version": "0.1.0",
  "private": true,
  "description": "BCM10 News — production-grade digital news platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@bcm10/web",
    "dev:admin": "turbo run dev --filter=@bcm10/admin",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,sql}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:push": "supabase db push --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:seed": "supabase db push --linked --include-seed",
    "db:types": "supabase gen types typescript --linked > packages/database/src/generated/database.types.ts",
    "db:lint": "supabase db lint --linked",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "supabase": "^2.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,sql}": [
      "prettier --write"
    ]
  }
}
