{
  "name": "bcm10-news",
  "version": "0.1.0",
  "private": true,
  "description": "BCM10 News \u2014 production-grade digital news platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@bcm10/web",
    "dev:admin": "turbo run dev --filter=@bcm10/admin",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace @bcm10/e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean && npm run clean:cache && rimraf node_modules",
    "db:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:push": "supabase db push --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:seed": "supabase db push --linked --include-seed",
    "db:types": "node scripts/gen-types.mjs",
    "db:lint": "supabase db lint --linked",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prepare": "husky || true",
    "clean:cache": "rimraf \"**/*.tsbuildinfo\" \"**/.next/types\"",
    "db:check-embeds": "node scripts/check-embeds.mjs",
    "db:verify": "node scripts/verify-database.mjs && node scripts/check-embeds.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "supabase": "^2.2.1",
    "tsx": "^4.23.13",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
