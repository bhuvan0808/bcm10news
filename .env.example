# =============================================================================
# BCM10 News — environment contract
# Copy to `.env.local` (root) for local dev. Never commit real values.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — put no secrets there.
# =============================================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_URL=http://localhost:54321/storage/v1/object/public/media
NEXT_PUBLIC_SITE_NAME="BCM10 News"
NEXT_PUBLIC_DEFAULT_LOCALE=te

# ---------- Supabase (Postgres + Auth + RLS) ----------
# Local values come from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=

# ---------- Cloudflare R2 (media storage) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bcm10-media
R2_PUBLIC_BASE_URL=https://images.bcm10news.in
# Leave blank to fall back to Supabase Storage in local dev.
MEDIA_DRIVER=supabase

# ---------- Resend (transactional + newsletter email) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL="BCM10 News <news@bcm10news.in>"
RESEND_REPLY_TO=support@bcm10news.in
RESEND_WEBHOOK_SECRET=

# ---------- Razorpay (subscriptions / payments) ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- PostHog (product + web analytics) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# ---------- Sentry (errors + performance) ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# ---------- OneSignal (web push) ----------
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---------- Internal secrets ----------
# Guards /api/revalidate and internal webhooks. Generate: openssl rand -hex 32
REVALIDATE_SECRET=
# Guards Vercel cron endpoints.
CRON_SECRET=

# ---------- Feature flags (build-time kill switches) ----------
FEATURE_PAYMENTS=false
FEATURE_PUSH=false
FEATURE_NEWSLETTER=false
FEATURE_B2B_LICENSING=false
FEATURE_COMMENTS=false
